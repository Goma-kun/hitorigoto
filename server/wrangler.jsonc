{
  "name": "hitorigoto-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "QUOTA", "id": "beabc16484dc49a8bd573fe8c4b8143c" }
  ],
  "vars": {
    // 端末 1 つあたりの 1 日の無料回数（日本時間で日付が変わると戻る）
    "FREE_PER_DAY": "3",
    // 全体の 1 日の上限（1 回 5〜10 円なので 20 回 ≒ 最大 200 円／日。2026-10-13 に 60 → 20：月 1 万円の予算に収めるため）
    "GLOBAL_PER_DAY": "20",
    // 受け付ける本文の上限（音声 32kbps・10 分でも 3MB 程度）
    "MAX_BODY_BYTES": "8000000",
    // 「詳しく聞く」（文字だけ・添削とは別枠）。1 回 1 円未満なので添削より多めに
    "EXPLAIN_PER_DAY": "10",
    "EXPLAIN_GLOBAL_PER_DAY": "100",
    "EXPLAIN_MAX_BODY_BYTES": "65536",
    // 月の予算（円）と、1 回あたりの見込みの原価（多めに見積もる）。日の上限 20×10＋100×1＝最大 300 円／日 ≒ 9,000 円／月。
    // 帳簿が予算に届いたら月末まで止まる（日の上限を上げても 1 万円は超えない）
    "MONTHLY_BUDGET_YEN": "10000",
    "REVIEW_COST_YEN": "10",
    "EXPLAIN_COST_YEN": "1"
  }
}
