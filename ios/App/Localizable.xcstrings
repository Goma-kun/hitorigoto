    },
    "💬 ほかの形も正解？ トラさんに聞く": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "💬 Other correct ways? Ask Tora"
          }
        }
      }
    },
    "%@ が話を振ります。%@で返してください。言葉が出てこなければ日本語で言えば、トラさんが%@にしてくれます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starts the conversation. Answer in %@. If the words won’t come, say it in your own language and Tora will put it into %@."
          }
        }
      }
    },
    "%@ が話を考え中…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is thinking…"
          }
        }
      }
    },
    "%@ とトラさんと気楽におしゃべり。詰まったら日本語で OK": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat casually with %@ and Tora. Stuck? Just say it in your language"
          }
        }
      }
    },
    "%@だけで": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ only"
          }
        }
      }
    },
    "%@だけで言えた %lld・助けてもらった %lld・直し %lld（終わると見られます）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
